#version 440 core
layout(std140) uniform TerrainData { mat4 viewProjection; mat4 modelTransform; mat4 normalTransform; vec4 uvOffsetScale[4]; vec4 uvRotation[4]; vec4 baseColorFactors[4]; vec4 emissiveMetallic[4]; vec4 roughnessAlpha[4]; vec4 terrainParams; };
uniform sampler2D compositionMap; uniform sampler2D layer0Map; uniform sampler2D layer1Map; uniform sampler2D layer2Map; uniform sampler2D layer3Map;
layout(location=0) in vec3 localPosition; layout(location=1) in vec3 worldNormal; layout(location=2) in vec2 compositionCoord;
layout(location=0) out vec4 outBaseColor; layout(location=1) out vec4 outOrm; layout(location=2) out vec4 outNormal; layout(location=3) out vec4 outEmissive;
vec2 uv(uint l,vec2 p){vec2 s=p*uvOffsetScale[l].zw,r=uvRotation[l].xy;return uvOffsetScale[l].xy+vec2(r.x*s.x-r.y*s.y,r.y*s.x+r.x*s.y);} vec4 sl(uint l,sampler2D t){if(terrainParams.w<2)return texture(t,uv(l,localPosition.xy));vec3 w=pow(abs(normalize(worldNormal)),vec3(4));w/=max(w.x+w.y+w.z,.000001);return texture(t,uv(l,localPosition.xy))*w.z+texture(t,uv(l,localPosition.yz))*w.x+texture(t,uv(l,vec2(-localPosition.x,localPosition.z)))*w.y;} vec4 cw(){if(terrainParams.z>.5){vec3 o=max(texture(compositionMap,localPosition.xy/terrainParams.x).rgb,vec3(0));o/=max(1.,o.x+o.y+o.z);return vec4(1.-o.x-o.y-o.z,o);}float a=texture(compositionMap,compositionCoord).a,b=texture(compositionMap,compositionCoord-vec2(2,0)).a,f=texture(compositionMap,compositionCoord-vec2(1,0)).a;return mix(mix(vec4(0,0,0,1),vec4(0,0,1,0),b),mix(vec4(0,1,0,0),vec4(1,0,0,0),a),f);} void main(){vec4 w=max(cw(),vec4(0));w/=max(dot(w,vec4(1)),.000001);vec4 s[4]=vec4[4](sl(0u,layer0Map),sl(1u,layer1Map),sl(2u,layer2Map),sl(3u,layer3Map));vec4 b=vec4(0);vec3 e=vec3(0);float m=0,r=0;for(uint i=0u;i<4u;++i){b+=s[i]*baseColorFactors[i]*w[i];e+=emissiveMetallic[i].rgb*w[i];m+=emissiveMetallic[i].a*w[i];r+=roughnessAlpha[i].x*w[i];}outBaseColor=b;outOrm=vec4(1,r,m,1);outNormal=vec4(normalize(worldNormal)*.5+.5,1);outEmissive=vec4(e,1);}
